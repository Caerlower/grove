# Copy to .env.local — never commit secrets.
# Faucet: https://hub.arkiv.network/faucet
# Access key: https://hub.arkiv.network

ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_WS_URL=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_API_KEY=

PROJECT_VALUE=grove-your-suffix
VAULT_ID=vault-your-suffix

# 32-byte vault key (base64), not a wallet key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_KEY=
DEMO_VAULT_KEY=

OWNER_ADDRESS=0x
OWNER_PRIVATE_KEY=0x

AGENT_PRIVATE_KEY=0x
AGENT_A_PRIVATE_KEY=0x
AGENT_B_PRIVATE_KEY=0x
ROGUE_PRIVATE_KEY=0x
AGENT_A_ADDRESS=0x
AGENT_B_ADDRESS=0x
ROGUE_ADDRESS=0x

# Exposed to the Next.js web app (apps/web/.env.local may mirror these)
NEXT_PUBLIC_ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
NEXT_PUBLIC_ARKIV_WS_URL=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
NEXT_PUBLIC_PROJECT_VALUE=
NEXT_PUBLIC_VAULT_ID=
NEXT_PUBLIC_OWNER_ADDRESS=
NEXT_PUBLIC_AGENT_A_ADDRESS=
NEXT_PUBLIC_WC_PROJECT_ID=

DRAFT_LIFE_SECONDS=600
GROVE_STRICT=0
ANTHROPIC_API_KEY=

# Optional HMAC for Claude demo OAuth tokens (defaults to ARKIV_API_KEY)
# MCP_OAUTH_HMAC_SECRET=

# Avoid MCP_SHARED_SECRET on Vercel if connecting Claude.ai custom connectors
